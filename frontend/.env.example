# Backend API base URL (the Portfolio CMS server)
VITE_API_URL=http://localhost:5000

# Backend API key generated in the admin panel (API Keys page).
# When set, the site fetches live content from /api/v1/portfolio with this key.
# Leave blank to fall back to the slug-based public API instead.
VITE_API_KEY=

# Fallback used only when VITE_API_KEY is empty.
VITE_PORTFOLIO_SLUG=gabrial-deora