PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio-cms

# JWT secret - use a long random string in production
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-portfolio.vercel.app

# Super admin credentials (used only by the seed script)
SEED_ADMIN_EMAIL=admin@gabrialdeora.com
SEED_ADMIN_PASSWORD=ChangeMe123!