# Copy this file to `.env` and fill in your values.
# The server auto-loads server/.env if present.

# Port the API/dashboard runs on
PORT=4000

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Secret used to sign the auth cookie. Use a long random string in production.
COOKIE_SECRET=generate-a-long-random-string-here

# Environment: development | production
NODE_ENV=development

# Optional: max JSON body size (default 256kb)
# BODY_LIMIT=256kb
